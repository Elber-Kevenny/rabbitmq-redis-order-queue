<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Inventory Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">
  <div class="container">
    <h1 class="mb-4">🍹 Inventory Control</h1>

   <div class="row">
  <!-- Latte Card -->
  <div class="col-md-4">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title text-capitalize">Latte</h5>
        <p class="card-text display-6" id="stock-latte">{{inventory.latte}}</p>
      </div>
    </div>
  </div>

  <!-- Coffee Card -->
  <div class="col-md-4">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title text-capitalize">Coffe</h5>
        <p class="card-text display-6" id="stock-coffe">{{inventory.coffe}}</p>
      </div>
    </div>
  </div>

  <!-- Cappuccino Card -->
  <div class="col-md-4">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title text-capitalize">Cappuccino</h5>
        <p class="card-text display-6" id="stock-cappuccino">{{inventory.cappuccino}}</p>
      </div>
    </div>
  </div>
</div>
    </div>
  </div>
    <script src="/scripts/dashBoard.js"></script>
</body>
</html>