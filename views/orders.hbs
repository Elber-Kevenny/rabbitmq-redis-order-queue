<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Place an Order - Coffee Shop</title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">

  <!-- Navbar Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <a class="navbar-link navbar-brand fw-bold" href="#">☕ Order System</a>
      <div class="navbar-nav ms-auto">
        {{!-- <a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2"></i> Inventory Dashboard</a> --}}
        <a class="nav-link active fw-semibold" href="/orders"><i class="bi bi-cart-plus"></i> New Order</a>
      </div>
    </div>
  </nav>

  <div class="container py-2">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h2 class="fw-bold mb-1">Place a Drink Order</h2>
            <p class="text-muted mb-0">Select your favorite drink to send a new order to the system queue.</p>
          </div>
          {{!-- <a href="/dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> View Dashboard
          </a> --}}
        </div>

        <!-- Alert Notification Box (JS Driven) -->
        <div id="alertBox" class="alert d-none shadow-sm" role="alert"></div>

        <!-- Order Form Card -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <form id="orderForm" >
              <div class="mb-3">
                <label for="drinkSelect" class="form-label fw-semibold">Select Drink</label>
                <select class="form-select form-select-lg" id="drinkSelect" name="drinkOrder" required>
                  <option value="" selected disabled>Choose a drink...</option>
                  <option value="latte">☕ Latte</option>
                  <option value="coffe">☕ Coffee</option>
                  <option value="cappuccino">☕ Cappuccino</option>
                </select>
              </div>
              <div class="mb-4">
                <label for="quantityInput" class="form-label fw-semibold">Quantity</label>
                <input type="number" class="form-control form-control-lg" id="quantityInput" name="quantity" value="1" min="1" max="10" required>
              </div>
              <!-- Input para o Nome do Usuário -->
              <div class="mb-3">
                <label for="usernameInput" class="form-label fw-semibold">Your Name</label>
                <input 
                  type="text" 
                  class="form-control form-control-lg" 
                  id="usernameInput" 
                  name="customer" 
                  placeholder="e.g. John Doe" 
                  required
                >
              </div>
              <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 fw-semibold">
                <i class="bi bi-send-fill me-1">Submit Order</i> 
              </button>
            </form>
          </div>
        </div>
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white fw-bold py-3">
            <i class="bi bi-cup-hot text-primary me-2"></i>Available Drinks
          </div>
          <div class="card-body p-0">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div>
                  <strong class="text-capitalize">Latte</strong>
                  <div class="small text-muted">Espresso with steamed milk and light foam</div>
                </div>
                <span class="badge bg-secondary rounded-pill">Popular</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div>
                  <strong class="text-capitalize">Coffee</strong>
                  <div class="small text-muted">Freshly brewed black coffee</div>
                </div>
                <span class="badge bg-secondary rounded-pill">Classic</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div>
                  <strong class="text-capitalize">Cappuccino</strong>
                  <div class="small text-muted">Equal parts espresso, steamed milk, and milk foam</div>
                </div>
                <span class="badge bg-secondary rounded-pill">Rich</span>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </div>
  <script src="/scripts/orders.js"></script>
</body>
</html>

