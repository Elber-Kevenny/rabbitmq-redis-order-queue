{
  "compilerOptions": {
    "types": ["node", "jest", "express"],
    "target": "es2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
