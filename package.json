{
  "name": "rabbitmq-redis-order-queue",
  "version": "1.0.0",
  "description": "High-performance, event-driven Order Management API using RabbitMQ for message queuing and Redis for distributed caching.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && npx tsx watch src/index.ts",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "dev:analytics": "npx tsx watch src/services/analytics/index.ts",
    "dev:ful": "npx tsx watch src/services/fulfillment/index.ts",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "author": "Elber",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.1",
    "redis": "^6.2.1"
  }
}
